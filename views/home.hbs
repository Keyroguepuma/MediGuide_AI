<div class="container">

  <!-- NAVBAR -->
  <div class="navbar">

    <div class="logo">
      <span>MEDIGUIDE AI</span>
    </div>

    <div class="disclaimer">
      MediGuide is not a real doctor, please consult medical professionals if it is serious.
    </div>

    <div class="nav-links">
      <button class="active">HOME</button>
      <button>ABOUT US</button>
      <button>Q&A</button>
      <button>CONTACT</button>
    </div>

  </div>

  <!-- HERO SECTION -->
 <div class="hero" id="heroSection">

    <h2>WELCOME TO</h2>
    <h1>MEDIGUIDE AI</h1>

    <div class="hero-text">
      <p>PLEASE ASK A QUESTION RELATED TO MEDICAL NEEDS TO START...</p>
    </div>

    <!-- CHAT CONTAINER -->
    <div class="chat-container">

      <!-- CHAT MESSAGES -->
      <div class="chat-box" id="chatBox">

        <!-- BOT MESSAGE -->
        <div class="message bot-message">
          Hello! Ask me anything about medications or symptoms.
        </div>

      </div>

      <!-- INPUT AREA -->
      <form id="chatForm" class="chat-input-area">

        <input
          type="text"
          id="medicineInput"
          name="medicineInput"
          placeholder="Ask about a medicine..."
          autocomplete="off"
        >

        <button type="submit">
          Send
        </button>

      </form>

    </div>

  </div>

  <div class="footer-space"></div>

</div>

<!-- JAVASCRIPT -->
<script>

  const chatForm = document.getElementById("chatForm");
  const chatBox = document.getElementById("chatBox");
  const medicineInput = document.getElementById("medicineInput");
  //Animation for chat box
  const heroSection =
  document.getElementById("heroSection");

let chatStarted = false;


  chatForm.addEventListener("submit", async function(event) {

    event.preventDefault();

    const message = medicineInput.value.trim();

    if(message === "") return;

    //Change the UI after first chat

    if(!chatStarted) {

  document
  .querySelector(".container")
  .classList.add("chat-fullscreen");

  chatStarted = true;

}

    // USER MESSAGE
    const userMessage = document.createElement("div");
    userMessage.classList.add("message", "user-message");
    userMessage.innerText = message;

    chatBox.appendChild(userMessage);

    // CLEAR INPUT
    medicineInput.value = "";

    // AUTO SCROLL
    chatBox.scrollTop = chatBox.scrollHeight;

    // TYPING MESSAGE
    const typingMessage = document.createElement("div");
    typingMessage.classList.add("message", "bot-message");

    typingMessage.innerText = "Typing...";

    chatBox.appendChild(typingMessage);

    chatBox.scrollTop = chatBox.scrollHeight;

    try {

      // SEND TO SERVER
      const response = await fetch("/input", {

        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({
          medicineInput: message
        })

      });

      const data = await response.json();

      // REMOVE TYPING
      typingMessage.remove();

      // BOT RESPONSE
      const botMessage = document.createElement("div");

      botMessage.classList.add("message", "bot-message");

      botMessage.innerText = data.reply || "No response.";

      chatBox.appendChild(botMessage);

      chatBox.scrollTop = chatBox.scrollHeight;

    }

    catch(error) {

      typingMessage.remove();

      const errorMessage = document.createElement("div");

      errorMessage.classList.add("message", "bot-message");

      errorMessage.innerText = "Something went wrong.";

      chatBox.appendChild(errorMessage);

    }

  });

</script>