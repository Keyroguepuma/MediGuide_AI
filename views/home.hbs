<div class="container">

  <div class="navbar">
    <div class="logo">
      <span>MEDIGUIDE AI</span>
    </div>

    <div class="disclaimer">
      MediGuide is not a real doctor, please consult medical professionals if it is serious.
    </div>

    <div class="nav-links">
      <button class="active">HOME</button>
      <button>ABOUT US</button>
      <button>Q&A</button>
      <button>CONTACT</button>
    </div>
  </div>

  <div class="hero">
    <h2>WELCOME TO</h2>
    <h1>MEDIGUIDE AI</h1>

    <div class="hero-text">
      <p>PLEASE ASK A QUESTION RELATED TO MEDICAL NEEDS TO START...</p>
    </div>

    <!-- INPUT AREA -->
    <form action="/input" method="POST" style="margin-top: 30px;" id="medicineForm">
      <input 
        type="text" 
        name="medicineInput"
        id="medicineInput" 
        placeholder="Enter Medicine..."
        style="padding: 10px; width: 300px;"
      >
      <button type="submit">Ask</button>
    </form>

    
    <p id="output"></p> <!--Placeholder for the output information -->

  </div>

  <div class="footer-space"></div>

</div>

<script>

  document.getElementById('medicineForm').addEventListener('submit', async function(e){
    
    //Prevents loading the Page
    e.preventDefault();

    const medicine = document.getElementById('medicineInput').value;
    
    //Get the information from the backend
    const res = await fetch('/input', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ medicineInput: medicine })
  });

  //Get the medicine JSON output from the AI
  const data = await res.json();
  console.log(data);

  //Use getElementByID to fill in the frontend. The console shows
  //the information to show the user

  document.getElementById("output").textContent = data.usedFor[1];

  });


</script>